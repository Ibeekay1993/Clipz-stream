# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# BACKEND_URL: Points to your hosted FastAPI Render server (e.g. https://clipz-stream.onrender.com)
BACKEND_URL=https://clipz-stream.onrender.com/

# SUPABASE_URL: Points to your Supabase Project endpoint URL (e.g. https://cgwlmqhdmcmkxkyoqiix.supabase.co/)
SUPABASE_URL=https://cgwlmqhdmcmkxkyoqiix.supabase.co/

# SUPABASE_ANON_KEY: Your Supabase Project Anon/Public secure API key used to make Rest calls.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- YouTube bot-check workarounds (backend/.env, not the app's .env) ---
# Cloud hosts (Render, Modal, etc.) share IP ranges YouTube already flags, so
# yt-dlp alone will frequently hit "Sign in to confirm you're not a bot."
# Fix it with ONE of the following:

# YTDLP_COOKIES_CONTENT: paste the full contents of a cookies.txt exported
# from a logged-in YouTube session in your browser (e.g. via the "Get
# cookies.txt LOCALLY" extension). Easiest option on Render/Modal since you
# can't mount a file.
YTDLP_COOKIES_CONTENT=dummy

# YTDLP_COOKIES_FILE: alternative to the above — absolute path to a
# cookies.txt already present on the server's disk.
YTDLP_COOKIES_FILE=dummy

# YTDLP_PROXY: route yt-dlp traffic through a residential/rotating proxy
# instead of the host's datacenter IP. Most reliable long-term fix.
YTDLP_PROXY=dummy

# YTDLP_PO_TOKEN: a YouTube "Proof of Origin" token if you're using one of
# the token-gated player clients (ios/android). Usually not needed if
# cookies or a proxy are set.
YTDLP_PO_TOKEN=dummy
