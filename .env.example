# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# BACKEND_URL: Points to your hosted FastAPI Render server (e.g. https://clipz-stream.onrender.com)
BACKEND_URL=https://clipz-stream.onrender.com/

# SUPABASE_URL: Points to your Supabase Project endpoint URL (e.g. https://cgwlmqhdmcmkxkyoqiix.supabase.co/)
SUPABASE_URL=https://cgwlmqhdmcmkxkyoqiix.supabase.co/

# SUPABASE_ANON_KEY: Your Supabase Project Anon/Public secure API key used to make Rest calls.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
